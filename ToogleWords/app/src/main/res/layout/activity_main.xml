<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Word Popup"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Test: bong bóng nổi + Accessibility nhận dạng word theo vị trí chạm."
            android:textSize="16sp" />

        <Button
            android:id="@+id/overlayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="1. Cấp quyền popup nổi" />

        <Button
            android:id="@+id/accessibilityButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="2. Mở cài đặt Trợ năng" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Đang kiểm tra..."
            android:textSize="15sp" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="3. Bắt đầu bong bóng" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Dừng bong bóng" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Cách test:&#10;&#10;• Bấm Bắt đầu bong bóng.&#10;• Ra một app có nhiều chữ.&#10;• Bấm bong bóng 💬 để vào Toggle Mode; bong bóng đổi thành ✓.&#10;• Chạm vào một word. App sẽ tìm node Accessibility tại vị trí đó, xác định character/word và phủ một ô vàng đúng vùng word.&#10;• Nhãn ✓ = lấy được vị trí ký tự từ Accessibility. Nhãn ~ = app đó không cung cấp character location nên hệ thống dùng vị trí ước lượng.&#10;• Chạm lại đúng word đã chọn để tắt highlight.&#10;• Bấm bong bóng lần nữa để thoát Toggle Mode."
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
